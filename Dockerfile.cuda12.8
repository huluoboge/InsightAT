# ─── InsightAT CUDA 12.8 + cuDSS Docker Build ─────────────────────────────────
#
# Builds InsightAT with CUDA-accelerated Ceres Solver (huluoboge/ceres-solver hy
# branch, with cuDSS sparse Cholesky support) and packages AppImage + .deb —
# all inside the container.
#
# Base: nvidia/cuda:12.8.0-devel-ubuntu22.04
#   - Ubuntu 22.04 (glibc 2.35) → AppImage/deb run on 22.04 and 24.04+.
#   - CUDA 12.8 toolkit + cuDSS (NVIDIA CUDA apt repo)
#
# Usage:
#   docker build -t insightat:cuda12.8 -f Dockerfile.cuda12.8 .
#   docker run --rm --gpus all -it insightat:cuda12.8
#
# Extract packages:
#   docker create --name insightat-tmp insightat:cuda12.8
#   docker cp insightat-tmp:/workspace/insightat/build-appimage-cuda12.8 ./
#   docker cp insightat-tmp:/workspace/insightat/build-deb-cuda12.8 ./
#   docker rm insightat-tmp
#
# ─────────────────────────────────────────────────────────────────────────────

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

WORKDIR /workspace/insightat

# ── System dependencies ──────────────────────────────────────────────────────
# NOTE: libceres-dev from apt is intentionally excluded — we build a custom
# Ceres with CUDA+cuDSS support from huluoboge/ceres-solver hy branch.
# Install cuDSS 0.7.1.4 from NVIDIA's redistributable archive (not apt): the
# CUDA apt repo's latest libcudss is 0.8.x, which breaks the hy-branch Ceres
# API (cudaDataType_t → cudssDataType_t).
ARG CUDSS_VERSION=0.7.1.4
ARG CUDSS_ARCHIVE=libcudss-linux-x86_64-${CUDSS_VERSION}_cuda12-archive
ARG CUDSS_URL=https://developer.download.nvidia.com/compute/cudss/redist/libcudss/linux-x86_64/${CUDSS_ARCHIVE}.tar.xz
ENV CUDSS_ROOT=/opt/nvidia/cudss/${CUDSS_VERSION}
ENV LD_LIBRARY_PATH=${CUDSS_ROOT}/lib:${CUDSS_ROOT}/lib64:${LD_LIBRARY_PATH}
ENV CMAKE_PREFIX_PATH=${CUDSS_ROOT}:${CMAKE_PREFIX_PATH}
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    libeigen3-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libopencv-dev \
    libgdal-dev \
    libglew-dev \
    libegl1-mesa-dev \
    libopengl0 \
    libsuitesparse-dev \
    libmetis-dev \
    libtbb-dev \
    libopenblas-dev \
    liblapack-dev \
    liblapacke-dev \
    libboost-filesystem-dev \
    libboost-program-options-dev \
    libboost-system-dev \
    p7zip-full \
    wget \
    xz-utils \
    file \
    fuse \
    libfuse2 \
    dpkg-dev \
    patchelf \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir "cmake>=3.24" \
    && cmake --version \
    && mkdir -p /opt/nvidia/cudss \
    && wget -q "${CUDSS_URL}" -O /tmp/cudss.tar.xz \
    && tar -xJf /tmp/cudss.tar.xz -C /opt/nvidia/cudss \
    && mv "/opt/nvidia/cudss/${CUDSS_ARCHIVE}" "${CUDSS_ROOT}" \
    && rm -f /tmp/cudss.tar.xz \
    && test -f "${CUDSS_ROOT}/include/cudss.h" \
    && (test -d "${CUDSS_ROOT}/lib/cmake/cudss" || test -d "${CUDSS_ROOT}/lib64/cmake/cudss") \
    && echo "cuDSS ${CUDSS_VERSION} installed at ${CUDSS_ROOT}" \
    && ls -la "${CUDSS_ROOT}"

# ── Custom Ceres-Solver (CUDA 12 + cuDSS 0.7) ────────────────────────────────
# Fork:   https://github.com/huluoboge/ceres-solver (hy branch)
# Script: build_cuda12.sh — configures cmake with CUDA 12.x flags + cuDSS.
# We run the script, then install to /usr/local so InsightAT's find_package
# picks it up automatically.
RUN git clone --branch hy --depth 1 --recurse-submodules https://github.com/huluoboge/ceres-solver.git /tmp/ceres-solver \
    && cd /tmp/ceres-solver \
    && chmod +x build_cuda12.sh \
    && CUDSS_CMAKE_DIR="$(find "${CUDSS_ROOT}" -type d -path '*/cmake/cudss' | head -1)" \
    && test -n "${CUDSS_CMAKE_DIR}" \
    && echo "Using cuDSS cmake dir: ${CUDSS_CMAKE_DIR}" \
    && sed -i "s|CUDSS_CMAKE_DIR=\".*\"|CUDSS_CMAKE_DIR=\"${CUDSS_CMAKE_DIR}\"|" build_cuda12.sh \
    && ./build_cuda12.sh \
    && cd build_cuda128 \
    && make install \
    && rm -rf /tmp/ceres-solver

# Verify Ceres and abseil are findable
RUN echo "CeresConfig: $(find /root -name CeresConfig.cmake 2>/dev/null)" \
    && echo "abslConfig:  $(find /root -name abslConfig.cmake 2>/dev/null)"

# ── Build InsightAT ──────────────────────────────────────────────────────────
COPY . .

ARG CMAKE_CUDA_ARCHITECTURES="60;61;70;75;80;86;89;90-virtual"
RUN CUDSS_CMAKE_DIR="$(find "${CUDSS_ROOT}" -type d -path '*/cmake/cudss' | head -1)" \
    && cmake -S . -B build-ceres-12.8 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}" \
    -DCeres_DIR="$HOME/.local/ceres-cuda128/lib/cmake/Ceres" \
    -Dcudss_DIR="${CUDSS_CMAKE_DIR}" \
    -DSIFTGPU_ENABLE_CUDA=OFF \
    && cmake --build build-ceres-12.8 -j"$(nproc)"

# Smoke test: CLI loads (no GPU work)
RUN build-ceres-12.8/isat_project --help 2>&1 | head -5 && echo "Smoke test OK"

# ── Package AppImage ─────────────────────────────────────────────────────────
ARG INSIGHTAT_VERSION=0.2.5-cuda12.8
ENV INSIGHTAT_BUILD_DIR=/workspace/insightat/build-ceres-12.8 \
    CUDA_LIBS_DIR=/usr/local/cuda-12.8/lib64 \
    VERSION=${INSIGHTAT_VERSION} \
    APPIMAGE_OUT_DIR=/workspace/insightat/build-appimage-cuda12.8 \
    APPIMAGE_EXTRACT_AND_RUN=1

# Use ./ prefix so BASH_SOURCE resolves the directory correctly
RUN cd /workspace/insightat && bash ./compile_appimage-12.8.sh

# ── Package Debian (.deb) — same Ubuntu 22.04 / CUDA 12.8 tree ───────────────
ENV DEB_OUTPUT_DIR=/workspace/insightat/build-deb-cuda12.8
RUN cd /workspace/insightat \
    && INSIGHTAT_BUILD_DIR="${INSIGHTAT_BUILD_DIR}" \
       VERSION="${VERSION}" \
       DEB_OUTPUT_DIR="${DEB_OUTPUT_DIR}" \
       bash ./scripts/package/package_deb.sh

CMD ["/bin/bash"]
