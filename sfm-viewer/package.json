{
  "name": "insightat-sfm-viewer",
  "version": "0.2.5",
  "private": true,
  "description": "WebGL SfM reconstruction viewer for COLMAP sparse models (tracks + cameras).",
  "homepage": "https://github.com/huluoboge/InsightAT",
  "author": "InsightAT Contributors <insightat@users.noreply.github.com>",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main.js",
  "scripts": {
    "start": "electron --no-sandbox .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/lib/colmap_loader.js && node --check src/lib/scene_math.js",
    "pack": "electron-builder --linux dir",
    "pack:appimage": "electron-builder --linux AppImage",
    "pack:deb": "electron-builder --linux deb",
    "pack:win": "electron-builder --win zip"
  },
  "dependencies": {
    "three": "^0.168.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.insightat.sfmviewer",
    "productName": "InsightAT SfM Viewer",
    "executableName": "insightat-sfm-viewer",
    "directories": {
      "output": "../dist/sfm-viewer"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "InsightAT Contributors <insightat@users.noreply.github.com>",
      "synopsis": "COLMAP sparse reconstruction viewer"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
